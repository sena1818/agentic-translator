data/glossaries/.*.lock

# 保留目录结构
!input/.gitkeep
!output/.gitkeep
!data/output/.gitkeep
!data/uploads/.gitkeep
!data/results/.gitkeep
!data/temp/.gitkeep
!output_final/.gitkeep
!BookTrans/.gitkeep

